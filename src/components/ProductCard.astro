---
interface Props {
  title: string;
  price: number;
  originalPrice?: number | undefined;
  badge?: string | undefined;
  badgeColor?: 'red' | 'green' | undefined;
  image: string;
  productHref?: string | undefined;
  hasPhysicalPurchase?: boolean | undefined;
  hasDigitalPurchase?: boolean | undefined;
}

const {
  title,
  price,
  originalPrice,
  badge,
  badgeColor = 'green',
  image,
  productHref,
  hasPhysicalPurchase = false,
  hasDigitalPurchase = false,
} = Astro.props;

const badgeBg = badgeColor === 'red' ? 'bg-[hsl(356,65%,63%)]' : 'bg-[hsl(148,45%,58%)]';
const internalLink = productHref ?? '#';
const hasInternalLink = internalLink !== '#';
let internalLinkLabel = 'View product';
if (hasDigitalPurchase && hasPhysicalPurchase) {
  internalLinkLabel = 'Shop & download';
} else if (hasDigitalPurchase) {
  internalLinkLabel = 'Download options';
} else if (hasPhysicalPurchase) {
  internalLinkLabel = 'Purchase options';
}
---

<div class="group relative overflow-hidden rounded-[1.75rem] border border-[hsl(180,15%,88%)] bg-white/95 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
  <div class="relative overflow-hidden aspect-[4/5] bg-[hsl(0,0%,96%)]">
    <a href={internalLink}>
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </a>

    <div class="absolute inset-x-3 top-3 flex items-start justify-between gap-3">
      {badge && (
        <span class={`inline-flex items-center rounded-full ${badgeBg} px-3 py-1 text-xs font-semibold text-white shadow-sm`}>
          {badge}
        </span>
      )}

      <div class="flex flex-wrap justify-end gap-2">
        {hasPhysicalPurchase && (
          <span class="inline-flex items-center rounded-full bg-white/90 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-[hsl(0,0%,25%)] shadow-sm">
            Physical
          </span>
        )}
        {hasDigitalPurchase && (
          <span class="inline-flex items-center rounded-full bg-[hsl(176,35%,63%)]/90 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-white shadow-sm">
            Digital
          </span>
        )}
      </div>
    </div>

    <div class="absolute inset-0 flex items-end justify-center bg-[linear-gradient(180deg,rgba(15,23,42,0)_45%,rgba(15,23,42,0.72)_100%)] p-5 opacity-0 transition-opacity duration-300 group-hover:opacity-100 pointer-events-none">
      <a
        href={internalLink}
        class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-white px-5 py-2 text-sm font-semibold text-[hsl(176,56%,28%)] shadow-md"
      >
        {!hasInternalLink && <ion-icon name="alert-circle-outline" aria-hidden="true" />}
        {internalLinkLabel}
      </a>
    </div>
  </div>

  <div class="space-y-4 p-5">
    <div>
      <h3 class="font-semibold text-[hsl(0,0%,9%)] text-lg leading-7 line-clamp-2">
        <a
          href={internalLink}
          class="hover:text-[hsl(176,35%,50%)]"
        >
          {title}
        </a>
      </h3>
    </div>

    <div class="flex items-end justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-xl font-bold text-[hsl(0,0%,9%)]">${price.toFixed(2)}</span>
        {originalPrice && (
          <span class="text-sm text-[hsl(0,0%,44%)] line-through">${originalPrice.toFixed(2)}</span>
        )}
      </div>
      <a
        href={internalLink}
        class="inline-flex items-center gap-2 rounded-full border border-[hsl(180,15%,88%)] px-4 py-2 text-sm font-semibold text-[hsl(0,0%,25%)] hover:border-[hsl(176,35%,63%)] hover:text-[hsl(176,56%,28%)]"
      >
        {internalLinkLabel}
        <ion-icon name="arrow-forward-outline" aria-hidden="true" />
      </a>
    </div>

    {!(hasPhysicalPurchase || hasDigitalPurchase) && (
      <p class="text-sm text-[hsl(0,0%,44%)]">Marketplace links coming soon.</p>
    )}
    {hasPhysicalPurchase && hasDigitalPurchase && (
      <p class="text-sm text-[hsl(0,0%,44%)]">Includes both physical buying options and digital download links.</p>
    )}
    {hasPhysicalPurchase && !hasDigitalPurchase && (
      <p class="text-sm text-[hsl(0,0%,44%)]">Compare live marketplace options for shipped parts and accessories.</p>
    )}
    {hasDigitalPurchase && !hasPhysicalPurchase && (
      <p class="text-sm text-[hsl(0,0%,44%)]">Open the product page to access download links and the optional donation flow.</p>
    )}
  </div>
</div>
