---
interface Props {
  title: string;
  price: number;
  originalPrice?: number | undefined;
  badge?: string | undefined;
  badgeColor?: 'red' | 'green' | undefined;
  image: string;
  productHref?: string | undefined;
  hasPhysicalPurchase?: boolean | undefined;
  hasDigitalPurchase?: boolean | undefined;
}

const {
  title,
  price,
  originalPrice,
  badge,
  badgeColor = 'green',
  image,
  productHref,
  hasPhysicalPurchase = false,
  hasDigitalPurchase = false,
} = Astro.props;

const badgeBg = badgeColor === 'red' ? 'bg-[hsl(356,65%,63%)]' : 'bg-[hsl(148,45%,58%)]';
const missingLinkHref = '#';
const internalLink = productHref ?? missingLinkHref;
let internalLinkLabel = 'View product';
if (internalLink === missingLinkHref) {
  internalLinkLabel = 'Coming soon';
} else if (hasDigitalPurchase && hasPhysicalPurchase) {
  internalLinkLabel = 'Shop + download';
} else if (hasDigitalPurchase) {
  internalLinkLabel = 'Download options';
} else if (hasPhysicalPurchase) {
  internalLinkLabel = 'Purchase options';
}
---

<div class="group overflow-hidden rounded-xl border border-[hsl(0,0%,90%)] bg-white shadow-sm transition-shadow duration-300 hover:shadow-lg">
  <a href={internalLink} class="block">
    <div class="relative overflow-hidden aspect-[4/5] bg-[hsl(0,0%,96%)]">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />

      <div class="absolute inset-x-3 top-3 flex items-start justify-between gap-3">
        {badge && (
          <span class={`inline-flex items-center rounded-full ${badgeBg} px-2.5 py-1 text-xs font-semibold text-white`}>
            {badge}
          </span>
        )}

        <div class="flex flex-wrap justify-end gap-2">
          {hasPhysicalPurchase && (
            <span class="inline-flex items-center rounded-full bg-white/90 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[hsl(0,0%,25%)]">
              Physical
            </span>
          )}
          {hasDigitalPurchase && (
            <span class="inline-flex items-center rounded-full bg-[hsl(176,35%,63%)]/90 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white">
              Digital
            </span>
          )}
        </div>
      </div>
    </div>
  </a>

  <div class="space-y-3 p-4">
    <h3 class="line-clamp-2 text-sm font-semibold leading-6 text-[hsl(0,0%,9%)] sm:text-base">
      <a
        href={internalLink}
        class="transition-colors hover:text-[hsl(176,35%,50%)]"
      >
        {title}
      </a>
    </h3>

    <div class="flex items-end justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold text-[hsl(0,0%,9%)]">${price.toFixed(2)}</span>
        {originalPrice && (
          <span class="text-sm text-[hsl(0,0%,44%)] line-through">${originalPrice.toFixed(2)}</span>
        )}
      </div>
      <a
        href={internalLink}
        class="inline-flex items-center gap-2 rounded-full border border-[hsl(0,0%,90%)] px-3 py-2 text-xs font-semibold text-[hsl(0,0%,25%)] transition-colors hover:border-[hsl(176,35%,63%)] hover:text-[hsl(176,56%,28%)]"
      >
        {internalLinkLabel}
        <ion-icon name="arrow-forward-outline" aria-hidden="true" />
      </a>
    </div>

    <p class="text-sm text-[hsl(0,0%,44%)]">
      {!(hasPhysicalPurchase || hasDigitalPurchase) && 'Marketplace links coming soon.'}
      {hasPhysicalPurchase && hasDigitalPurchase && 'Includes both shipped product options and digital downloads.'}
      {hasPhysicalPurchase && !hasDigitalPurchase && 'Compare live marketplace options for shipped parts and accessories.'}
      {hasDigitalPurchase && !hasPhysicalPurchase && 'Open the product page to access download links and the optional support flow.'}
    </p>
  </div>
</div>
