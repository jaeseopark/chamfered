---
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/60 bg-white/80 backdrop-blur-xl transition-shadow duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 text-xl font-bold text-[hsl(0,0%,9%)]">
        <img src="/images/logo.svg" alt="Chamfered logo" width="32" height="32" />
        <div class="leading-none">
          <span class="block">Chamfered</span>
          <span class="block text-[0.65rem] font-medium uppercase tracking-[0.32em] text-[hsl(176,56%,28%)]">
            Functional 3D goods
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8">
        <a
          href="/#shop"
          class="text-sm font-medium text-[hsl(0,0%,35%)] hover:text-[hsl(176,56%,28%)]"
        >Shop</a>
        <a
          href="/#about"
          class="text-sm font-medium text-[hsl(0,0%,35%)] hover:text-[hsl(176,56%,28%)]"
        >About</a>
        <a
          href="/#contact"
          class="text-sm font-medium text-[hsl(0,0%,35%)] hover:text-[hsl(176,56%,28%)]"
        >Contact</a>
        <a
          href="/products/"
          class="inline-flex items-center gap-2 rounded-full border border-[hsl(176,35%,63%)] bg-white px-4 py-2 text-sm font-semibold text-[hsl(176,56%,28%)] shadow-sm hover:-translate-y-0.5 hover:shadow-md"
        >
          Browse catalog
          <ion-icon name="arrow-forward-outline" aria-hidden="true" />
        </a>
      </nav>

      <button
        id="mobile-menu-btn"
        aria-label="Open Menu"
        class="md:hidden rounded-full border border-[hsl(0,0%,88%)] p-2 text-[hsl(0,0%,35%)] hover:bg-white"
      >
        <span class="block w-5 h-0.5 bg-current mb-1"></span>
        <span class="block w-5 h-0.5 bg-current mb-1"></span>
        <span class="block w-5 h-0.5 bg-current"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/70 bg-white/95 px-4 pb-5 shadow-lg backdrop-blur md:hidden"
  >
    <nav class="flex flex-col gap-4 pt-4">
      <a href="/#shop" class="text-sm font-medium text-[hsl(0,0%,35%)] hover:text-[hsl(176,56%,28%)]">Shop</a>
      <a href="/#about" class="text-sm font-medium text-[hsl(0,0%,35%)] hover:text-[hsl(176,56%,28%)]">About</a>
      <a href="/#contact" class="text-sm font-medium text-[hsl(0,0%,35%)] hover:text-[hsl(176,56%,28%)]">Contact</a>
      <a
        href="/products/"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-[hsl(176,35%,63%)] px-4 py-3 text-sm font-semibold text-white shadow-sm"
      >
        Browse catalog
        <ion-icon name="arrow-forward-outline" aria-hidden="true" />
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });

  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY >= 50) {
      header?.classList.add('shadow-lg');
    } else {
      header?.classList.remove('shadow-lg');
    }
  });
</script>
