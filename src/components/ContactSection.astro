---
---

<section id="contact" class="py-20 bg-white scroll-mt-16">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(0,0%,9%)] mb-4">Contact</h2>
    <p class="text-[hsl(0,0%,44%)] mb-10">
      Have a question, a custom order request, or want to work together? Reach out — I'd love to hear from you.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a
        href="#"
        data-email-obfuscate
        class="inline-flex items-center gap-2 bg-[hsl(176,35%,63%)] hover:bg-[hsl(176,35%,50%)] text-white font-semibold px-8 py-3 rounded-full transition-colors duration-200 shadow-md"
      >
        <ion-icon name="mail-outline" aria-hidden="true" />
        Send an Email
      </a>
    </div>

    <ul class="flex items-center justify-center gap-6">
      <li>
        <a
          href="https://www.instagram.com/chamfered3d/"
          class="flex items-center gap-2 text-[hsl(0,0%,44%)] hover:text-[hsl(176,35%,50%)] transition-colors text-sm font-medium"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Instagram"
        >
          <ion-icon name="logo-instagram" style="font-size: 1.5rem;" />
          <span>Instagram</span>
        </a>
      </li>
      <li>
        <a
          href="https://www.tiktok.com/@chamfered3d"
          class="group flex items-center gap-2 text-[hsl(0,0%,44%)] hover:text-[hsl(176,35%,50%)] transition-colors text-sm font-medium"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="TikTok"
        >
          <img src="/images/tiktok.svg" alt="" aria-hidden="true" width="24" height="24" class="opacity-50 transition-opacity group-hover:opacity-100" />
          <span>TikTok</span>
        </a>
      </li>
      <li>
        <a
          href="https://www.youtube.com/@chamfered3d"
          class="flex items-center gap-2 text-[hsl(0,0%,44%)] hover:text-[hsl(176,35%,50%)] transition-colors text-sm font-medium"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="YouTube"
        >
          <ion-icon name="logo-youtube" style="font-size: 1.5rem;" />
          <span>YouTube</span>
        </a>
      </li>
    </ul>
  </div>
</section>
