---
---

<footer class="mt-20 border-t border-[hsl(180,15%,88%)] bg-[hsl(176,56%,12%)] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_auto] md:items-start">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src="/images/logo.svg" alt="Chamfered logo" width="32" height="32" />
          <div>
            <p class="text-lg font-semibold">Chamfered</p>
            <p class="text-sm text-white/70">Modern 3D products, digital files, and custom builds.</p>
          </div>
        </div>
        <p class="max-w-md text-sm leading-6 text-white/70">
          Designed for practical everyday use, from printable files to finished parts ready to ship.
        </p>
      </div>

      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-white/60">Explore</p>
        <ul class="space-y-3 text-sm text-white/80">
          <li><a href="/#shop" class="hover:text-white">Featured products</a></li>
          <li><a href="/products/" class="hover:text-white">Full catalog</a></li>
          <li><a href="/#contact" class="hover:text-white">Custom work</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-start gap-4 md:items-end">
        <ul class="flex items-center gap-4">
          <li>
            <a
              href="https://www.instagram.com/chamfered3d/"
              class="inline-flex rounded-full border border-white/15 bg-white/5 p-3 text-white/80 hover:-translate-y-0.5 hover:bg-white/10 hover:text-white"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="Instagram"
            >
              <ion-icon name="logo-instagram" style="font-size: 1.25rem;" />
            </a>
          </li>
          <li>
            <a
              href="https://www.tiktok.com/@chamfered3d"
              class="inline-flex rounded-full border border-white/15 bg-white/5 p-3 text-white/80 hover:-translate-y-0.5 hover:bg-white/10 hover:text-white"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="TikTok"
            >
              <img src="/images/tiktok.svg" alt="" aria-hidden="true" width="20" height="20" class="brightness-0 invert opacity-80" />
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@chamfered3d"
              class="inline-flex rounded-full border border-white/15 bg-white/5 p-3 text-white/80 hover:-translate-y-0.5 hover:bg-white/10 hover:text-white"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="YouTube"
            >
              <ion-icon name="logo-youtube" style="font-size: 1.25rem;" />
            </a>
          </li>
        </ul>
        <p class="text-sm text-white/60">&copy; 2026 Chamfered. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
