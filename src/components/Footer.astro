---
---

<footer class="bg-[hsl(0,0%,9%)] text-white mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- Brand -->
      <div class="flex items-center gap-2">
        <img src="/images/logo.svg" alt="Chamfered logo" width="28" height="28" />
        <span class="font-semibold text-lg">Chamfered</span>
      </div>

      <p class="text-sm text-[hsl(0,0%,60%)]">&copy; 2026 Chamfered. All rights reserved.</p>

      <!-- Social links -->
      <ul class="flex items-center gap-4">
        <li>
          <a
            href="https://www.instagram.com/chamfered3d/"
            class="text-[hsl(0,0%,60%)] hover:text-white transition-colors"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Instagram"
          >
            <ion-icon name="logo-instagram" style="font-size: 1.25rem;" />
          </a>
        </li>
        <li>
          <a
            href="https://www.tiktok.com/@chamfered3d"
            class="text-[hsl(0,0%,60%)] hover:text-white transition-colors flex items-center"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="TikTok"
          >
            <img src="/images/tiktok.svg" alt="" aria-hidden="true" width="20" height="20" style="filter: brightness(0.6);" />
          </a>
        </li>
        <li>
          <a
            href="https://www.youtube.com/@chamfered3d"
            class="text-[hsl(0,0%,60%)] hover:text-white transition-colors"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="YouTube"
          >
            <ion-icon name="logo-youtube" style="font-size: 1.25rem;" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
