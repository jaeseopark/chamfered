---
interface Props {
  icon: string;
  title: string;
}
const { icon, title } = Astro.props;
---

<div class="rounded-[1.5rem] border border-[hsl(180,15%,88%)] bg-white p-6 shadow-sm">
  <div class="mb-4 inline-flex rounded-2xl bg-[hsl(176,35%,63%)]/12 p-3 text-[hsl(176,56%,28%)]">
    <ion-icon name={icon} aria-hidden="true" class="text-xl" />
  </div>
  <h3 class="font-semibold text-[hsl(0,0%,9%)] mb-2 flex items-center gap-2 text-lg">
    {title}
  </h3>
  <p class="text-sm text-[hsl(0,0%,38%)] leading-relaxed">
    <slot />
  </p>
</div>
