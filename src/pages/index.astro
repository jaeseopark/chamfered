---
import { APPS } from '../consts';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout>
  <div class="min-h-screen flex items-center justify-center bg-white px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-3">Chamfered</h1>
        <p class="text-gray-600">A collection of independent web applications</p>
      </div>

      <nav class="space-y-3">
        {APPS.map((app) => (
          <a
            href={app.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full p-4 border border-gray-300 rounded-lg hover:border-gray-600 hover:shadow-md transition-all duration-200"
          >
            <div class="font-semibold text-lg">{app.name}</div>
            <div class="text-sm text-gray-600">{app.description}</div>
          </a>
        ))}
      </nav>
    </div>
  </div>
</Layout>
