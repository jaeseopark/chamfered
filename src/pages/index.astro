---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Fetch and sort products from content collection
const allProducts = await getCollection('products');
const products = allProducts
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout>
  <Header />

  <main class="pt-16">

    <!-- #HERO -->
    <section
      id="home"
      class="relative flex items-center justify-center min-h-[75vh] bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/hero-bg.jpg');"
    >
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 text-center px-4 max-w-2xl mx-auto">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          Ready-to-print 3D Models
        </h1>
        <a
          href="https://makerworld.com/en/@jaeseopark/upload"
          class="inline-flex items-center gap-2 bg-[hsl(176,35%,63%)] hover:bg-[hsl(176,35%,50%)] text-white font-semibold text-base px-8 py-3 rounded-full transition-colors duration-200 shadow-lg"
          target="_blank"
          rel="noreferrer noopener"
        >
          Download for free
          <ion-icon name="open-outline" aria-hidden="true" />
        </a>
      </div>
    </section>


    <!-- #PRODUCTS OF THE WEEK -->
    <section id="shop" class="py-20 bg-white scroll-mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(0,0%,9%)] mb-3">
            Products of the Week
          </h2>
          <p class="text-[hsl(0,0%,44%)] max-w-xl mx-auto">
            Handpicked items from Chamfered's latest 3D-printed creations and digital designs.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
          {products.map((product) => (
            <ProductCard
              title={product.data.title}
              price={product.data.price}
              originalPrice={product.data.originalPrice}
              badge={product.data.badge}
              badgeColor={product.data.badgeColor}
              image={product.data.image}
              ebayLink={product.data.ebayLink}
              makerWorldLink={product.data.makerWorldLink}
            />
          ))}
        </div>
      </div>
    </section>


    <!-- #ABOUT -->
    <section id="about" class="py-20 bg-[hsl(0,0%,96%)] scroll-mt-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(0,0%,9%)] mb-6">About</h2>

        <p class="text-[hsl(0,0%,30%)] text-base leading-relaxed mb-10">
          Hi, I'm Jaeseo. I design and sell functional 3D prints and digital files created to solve
          real-world problems. Whether it's a custom tool, a specific hardware adapter, or an
          everyday fix, I build things that actually work.
        </p>

        <div class="grid sm:grid-cols-3 gap-6 mb-10">
          <!-- Digital Files card -->
          <div class="bg-white rounded-lg p-6 border-l-4 border-[hsl(176,35%,63%)] shadow-sm">
            <h3 class="font-semibold text-[hsl(0,0%,9%)] mb-2 flex items-center gap-2">
              <ion-icon name="document-outline" aria-hidden="true" class="text-[hsl(176,35%,63%)]" />
              Digital Files
            </h3>
            <p class="text-sm text-[hsl(0,0%,44%)] leading-relaxed">
              Ready-to-print STL files for your own machine.{' '}
              <a
                href="https://makerworld.com/en/@jaeseopark/upload"
                class="text-[hsl(176,35%,50%)] hover:underline font-medium"
                target="_blank"
                rel="noreferrer noopener"
              >Browse the MakerWorld shop</a>.
            </p>
          </div>

          <!-- Custom Design card -->
          <div class="bg-white rounded-lg p-6 border-l-4 border-[hsl(176,35%,63%)] shadow-sm">
            <h3 class="font-semibold text-[hsl(0,0%,9%)] mb-2 flex items-center gap-2">
              <ion-icon name="pencil-outline" aria-hidden="true" class="text-[hsl(176,35%,63%)]" />
              Custom Design
            </h3>
            <p class="text-sm text-[hsl(0,0%,44%)] leading-relaxed">
              Bespoke CAD modeling to create specific parts you can't find elsewhere.{' '}
              <a href="#" data-email-obfuscate class="text-[hsl(176,35%,50%)] hover:underline font-medium">
                Email me
              </a>{' '}
              to start your project.
            </p>
          </div>

          <!-- Physical Goods card -->
          <div class="bg-white rounded-lg p-6 border-l-4 border-[hsl(176,35%,63%)] shadow-sm">
            <h3 class="font-semibold text-[hsl(0,0%,9%)] mb-2 flex items-center gap-2">
              <ion-icon name="cube-outline" aria-hidden="true" class="text-[hsl(176,35%,63%)]" />
              Physical Goods
            </h3>
            <p class="text-sm text-[hsl(0,0%,44%)] leading-relaxed">
              Durable, 3D-printed items shipped directly to you.{' '}
              <a
                href="#"
                class="text-[hsl(176,35%,50%)] hover:underline font-medium"
                target="_blank"
                rel="noreferrer noopener"
              >See the Etsy catalog</a>.<sup><a href="#direct-order" class="text-[hsl(176,35%,50%)]">*</a></sup>
            </p>
          </div>
        </div>

        <p id="direct-order" class="text-sm text-[hsl(0,0%,44%)] leading-relaxed mb-4 border-t border-[hsl(0,0%,90%)] pt-4">
          <strong class="text-[hsl(0,0%,30%)]">*</strong> I am always open to working out a deal outside of Etsy to bypass
          platform fees and pass those savings directly to you. For custom designs, bulk orders, or direct
          purchases, <a href="#" data-email-obfuscate class="text-[hsl(176,35%,50%)] hover:underline font-medium">email me</a> with what you are looking to buy!
        </p>

        <p class="text-sm text-[hsl(0,0%,44%)] leading-relaxed">
          I also provide <strong class="text-[hsl(0,0%,30%)]">Software Consulting</strong> for web applications
          and server-side development. If you have a technical project or need help with backend architecture,
          feel free to get in touch.
        </p>
      </div>
    </section>


    <!-- #CONTACT -->
    <section id="contact" class="py-20 bg-white scroll-mt-16">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(0,0%,9%)] mb-4">Contact</h2>
        <p class="text-[hsl(0,0%,44%)] mb-10">
          Have a question, a custom order request, or want to work together? Reach out — I'd love to hear from you.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
          <a
            href="#"
            data-email-obfuscate
            class="inline-flex items-center gap-2 bg-[hsl(176,35%,63%)] hover:bg-[hsl(176,35%,50%)] text-white font-semibold px-8 py-3 rounded-full transition-colors duration-200 shadow-md"
          >
            <ion-icon name="mail-outline" aria-hidden="true" />
            Send an Email
          </a>
        </div>

        <ul class="flex items-center justify-center gap-6">
          <li>
            <a
              href="https://www.instagram.com/chamfered3d/"
              class="flex items-center gap-2 text-[hsl(0,0%,44%)] hover:text-[hsl(176,35%,50%)] transition-colors text-sm font-medium"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="Instagram"
            >
              <ion-icon name="logo-instagram" style="font-size: 1.5rem;" />
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.tiktok.com/@chamfered3d"
              class="flex items-center gap-2 text-[hsl(0,0%,44%)] hover:text-[hsl(176,35%,50%)] transition-colors text-sm font-medium"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="TikTok"
            >
              <img src="/images/tiktok.svg" alt="" aria-hidden="true" width="24" height="24" class="opacity-50" />
              <span>TikTok</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@chamfered3d"
              class="flex items-center gap-2 text-[hsl(0,0%,44%)] hover:text-[hsl(176,35%,50%)] transition-colors text-sm font-medium"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="YouTube"
            >
              <ion-icon name="logo-youtube" style="font-size: 1.5rem;" />
              <span>YouTube</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <Footer />

  <!-- Email obfuscation script -->
  <script>
    const emailLinks = document.querySelectorAll('a[data-email-obfuscate]');
    if (emailLinks.length > 0) {
      const defaultLocalPart = [106, 97, 101, 115, 101, 111]
        .map((code) => String.fromCharCode(code))
        .join('');
      const defaultDomain = [99, 104, 97, 109, 102, 101, 114, 101, 100, 46, 100, 101, 118]
        .map((code) => String.fromCharCode(code))
        .join('');
      const subject = encodeURIComponent('Chamfered Order Inquiry');
      emailLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          const anchor = link as HTMLAnchorElement;
          const emailAddress = anchor.dataset['email'] ?? `${defaultLocalPart}@${defaultDomain}`;
          window.location.href = `mailto:${emailAddress}?subject=${subject}`;
        });
      });
    }
  </script>
</Layout>
