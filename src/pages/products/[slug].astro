---
import { getCollection, render } from 'astro:content';
import { DEFAULT_DONATION_AMOUNTS, DONATION_CURRENCY, MIN_DONATION_AMOUNT, PAYPAL_DONATION_URL } from '../../consts';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const products = await getCollection('products');

  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const pageDescription = product.body?.trim() || `${product.data.title} by Chamfered`;
const physicalPurchaseLinks = [
  product.data.purchase.physical?.ebay
    ? { href: product.data.purchase.physical.ebay, label: 'Buy on eBay', icon: 'pricetag-outline', accent: 'bg-[#e53238]' }
    : null,
  product.data.purchase.physical?.amazon
    ? { href: product.data.purchase.physical.amazon, label: 'Buy on Amazon', icon: 'logo-amazon', accent: 'bg-[#ff9900]' }
    : null,
  product.data.purchase.physical?.etsy
    ? { href: product.data.purchase.physical.etsy, label: 'Buy on Etsy', icon: 'bag-handle-outline', accent: 'bg-[#f1641e]' }
    : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
const digitalPurchaseLinks = [
  product.data.purchase.digital?.makerworld
    ? { href: product.data.purchase.digital.makerworld, label: 'Download from MakerWorld', icon: 'cube-outline', accent: 'bg-[#0f766e]' }
    : null,
  product.data.purchase.digital?.printables
    ? { href: product.data.purchase.digital.printables, label: 'Download from Printables', icon: 'print-outline', accent: 'bg-[#fa6831]' }
    : null,
  product.data.purchase.digital?.thingiverse
    ? { href: product.data.purchase.digital.thingiverse, label: 'Download from Thingiverse', icon: 'layers-outline', accent: 'bg-[#248bfb]' }
    : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
---

<Layout title={`${product.data.title} | Chamfered`} description={pageDescription}>
  <Header />

  <main class="pt-20 pb-20 bg-white min-h-[70vh]">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/#shop"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[hsl(176,35%,45%)] hover:text-[hsl(176,35%,35%)] transition-colors mb-8"
      >
        <ion-icon name="arrow-back-outline" aria-hidden="true" />
        Back to products
      </a>

      <article class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div class="bg-[hsl(0,0%,97%)] rounded-xl border border-[hsl(0,0%,90%)] overflow-hidden">
          <img
            src={product.data.image}
            alt={product.data.title}
            class="w-full h-full object-cover aspect-[4/5]"
          />
        </div>

        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-[hsl(0,0%,9%)] leading-tight mb-3">
            {product.data.title}
          </h1>

          <div class="flex items-center gap-3 mb-6">
            <p class="text-2xl font-bold text-[hsl(0,0%,9%)]">
              ${product.data.price.toFixed(2)}
            </p>
            {product.data.originalPrice && (
              <p class="text-base text-[hsl(0,0%,44%)] line-through">
                ${product.data.originalPrice.toFixed(2)}
              </p>
            )}
            {product.data.badge && (
              <span class={`inline-flex items-center text-xs px-2 py-1 rounded text-white ${product.data.badgeColor === 'red' ? 'bg-[hsl(356,65%,63%)]' : 'bg-[hsl(148,45%,58%)]'}`}>
                {product.data.badge}
              </span>
            )}
          </div>

          <div class="prose prose-sm max-w-none text-[hsl(0,0%,30%)] mb-8">
            <Content />
          </div>

          <div class="flex flex-wrap items-center gap-3">
            {physicalPurchaseLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer noopener"
                class={`inline-flex items-center gap-2 ${link.accent} hover:brightness-95 text-white text-sm font-semibold px-5 py-3 rounded-full transition duration-200`}
              >
                <ion-icon name={link.icon} aria-hidden="true" />
                {link.label}
              </a>
            ))}

            {digitalPurchaseLinks.length > 0 && (
              <>
                <button
                  type="button"
                  class="inline-flex items-center gap-2 bg-[hsl(176,35%,63%)] hover:bg-[hsl(176,35%,50%)] text-white text-sm font-semibold px-5 py-3 rounded-full transition-colors"
                  data-digital-download-trigger
                  data-paypal-url={PAYPAL_DONATION_URL}
                  data-donation-currency={DONATION_CURRENCY}
                  data-min-donation-amount={MIN_DONATION_AMOUNT}
                  aria-haspopup="dialog"
                >
                  <ion-icon name="download-outline" aria-hidden="true" />
                  Download Design File
                </button>

                <dialog
                  class="w-full max-w-md rounded-2xl border border-[hsl(0,0%,85%)] p-0 shadow-2xl backdrop:bg-black/40"
                  data-donation-dialog
                >
                  <div class="p-6 sm:p-7">
                    <div class="flex items-start justify-between gap-4 mb-4">
                      <div>
                        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[hsl(176,35%,45%)] mb-2">
                          Optional donation
                        </p>
                        <h2 class="text-2xl font-bold text-[hsl(0,0%,9%)]">Support this design</h2>
                      </div>
                      <button
                        type="button"
                        class="rounded-full border border-[hsl(0,0%,85%)] px-3 py-1 text-sm font-medium text-[hsl(0,0%,35%)]"
                        data-close-donation-dialog
                      >
                        Close
                      </button>
                    </div>

                    <p class="text-sm text-[hsl(0,0%,35%)] mb-5">
                      If you'd like, you can send a quick PayPal tip before downloading. You can also skip and go straight to the design files.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                      {DEFAULT_DONATION_AMOUNTS.map((amount) => (
                        <button
                          type="button"
                          class="inline-flex items-center justify-center gap-2 rounded-full border border-[hsl(0,0%,86%)] px-4 py-3 text-sm font-semibold text-[hsl(0,0%,18%)] hover:border-[hsl(176,35%,50%)] hover:text-[hsl(176,35%,40%)] transition-colors"
                          data-donation-amount={amount}
                        >
                          <ion-icon name="logo-paypal" aria-hidden="true" />
                          Donate ${amount}
                        </button>
                      ))}
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3 mb-5">
                      <input
                        type="number"
                      min={MIN_DONATION_AMOUNT}
                        step="0.01"
                        inputmode="decimal"
                        placeholder={`Custom amount (${DONATION_CURRENCY})`}
                        class="w-full rounded-full border border-[hsl(0,0%,86%)] px-4 py-3 text-sm text-[hsl(0,0%,18%)] focus:outline-none focus:border-[hsl(176,35%,50%)]"
                        data-custom-donation-amount
                      />
                      <button
                        type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-full bg-[hsl(0,0%,9%)] px-5 py-3 text-sm font-semibold text-white hover:bg-[hsl(0,0%,18%)] transition-colors"
                        data-custom-donation-submit
                      >
                        <ion-icon name="logo-paypal" aria-hidden="true" />
                        Donate
                      </button>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">
                      <button
                        type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-full bg-[hsl(176,35%,63%)] px-5 py-3 text-sm font-semibold text-white hover:bg-[hsl(176,35%,50%)] transition-colors"
                        data-skip-donation
                      >
                        <ion-icon name="arrow-forward-outline" aria-hidden="true" />
                        Skip to download
                      </button>
                      <p class="self-center text-sm text-[hsl(0,0%,45%)]">
                        Currency: {DONATION_CURRENCY}
                      </p>
                    </div>
                  </div>
                </dialog>

                <div class="hidden basis-full" data-digital-download-links>
                  <div class="mt-2 rounded-2xl border border-[hsl(0,0%,90%)] bg-[hsl(0,0%,98%)] p-4 sm:p-5">
                    <p class="text-sm text-[hsl(0,0%,35%)] mb-4" data-download-status>
                      Download links are ready below.
                    </p>
                    <div class="flex flex-wrap items-center gap-3">
                      {digitalPurchaseLinks.map((link) => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noreferrer noopener"
                          class={`inline-flex items-center gap-2 ${link.accent} hover:brightness-95 text-white text-sm font-semibold px-5 py-3 rounded-full transition duration-200`}
                        >
                          <ion-icon name={link.icon} aria-hidden="true" />
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            )}

            <a
              href="/#shop"
              class="inline-flex items-center gap-2 text-sm font-semibold border border-[hsl(0,0%,86%)] text-[hsl(0,0%,25%)] hover:border-[hsl(0,0%,70%)] px-5 py-3 rounded-full transition-colors"
            >
              Browse more products
            </a>
          </div>
        </div>
      </article>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const downloadTrigger = document.querySelector('[data-digital-download-trigger]');
  const donationDialog = document.querySelector('[data-donation-dialog]');
  const digitalDownloadLinks = document.querySelector('[data-digital-download-links]');
  const downloadStatus = document.querySelector('[data-download-status]');
  const customDonationInput = document.querySelector('[data-custom-donation-amount]');
  const minimumDonationAmount = Number(downloadTrigger instanceof HTMLElement
    ? downloadTrigger.dataset.minDonationAmount
    : undefined) || 1;
  const closeDonationDialog = () => {
    if (!(donationDialog instanceof HTMLDialogElement)) {
      return;
    }
    if (donationDialog.open) {
      donationDialog.close();
    }
  };
  const revealDownloads = (message: string) => {
    if (!(digitalDownloadLinks instanceof HTMLElement) || !(downloadStatus instanceof HTMLElement)) {
      console.warn('Digital download UI is missing required elements.');
      return;
    }
    digitalDownloadLinks.classList.remove('hidden');
    downloadStatus.textContent = message;
  };
  const resetCustomDonationValidity = () => {
    if (customDonationInput instanceof HTMLInputElement) {
      customDonationInput.setCustomValidity('');
    }
  };
  const getCustomDonationAmount = () => {
    if (!(customDonationInput instanceof HTMLInputElement)) {
      return null;
    }
    resetCustomDonationValidity();
    const amount = Number(customDonationInput.value);
    if (!Number.isFinite(amount) || amount < minimumDonationAmount) {
      customDonationInput.setCustomValidity(`Please enter a donation amount of at least $${minimumDonationAmount.toFixed(2)}.`);
      customDonationInput.reportValidity();
      return null;
    }
    return amount;
  };
  customDonationInput?.addEventListener('input', resetCustomDonationValidity);
  const openPayPalDonation = (amount: number) => {
    if (!(downloadTrigger instanceof HTMLElement)) {
      console.warn('Digital download trigger is missing.');
      revealDownloads('Download links are ready below.');
      return;
    }
    const paypalUrl = downloadTrigger.dataset.paypalUrl;
    if (!paypalUrl) {
      console.warn('PayPal donation URL is missing.');
      revealDownloads('Download links are ready below.');
      return;
    }
    const donationCurrency = downloadTrigger.dataset.donationCurrency ?? 'USD';
    const donationUrl = new URL(paypalUrl);
    donationUrl.searchParams.set('amount', amount.toFixed(2));
    donationUrl.searchParams.set('currency_code', donationCurrency);
    window.open(donationUrl.toString(), '_blank', 'noopener,noreferrer');
    revealDownloads('Thanks for supporting Chamfered — your PayPal donation page opened in a new tab.');
  };

  if (downloadTrigger instanceof HTMLButtonElement) {
    downloadTrigger.addEventListener('click', () => {
      if (donationDialog instanceof HTMLDialogElement) {
        donationDialog.showModal();
        return;
      }
      revealDownloads('Download links are ready below.');
    });
  }

  document.querySelectorAll('[data-close-donation-dialog]').forEach((button) => {
    button.addEventListener('click', closeDonationDialog);
  });

  document.querySelectorAll('[data-donation-amount]').forEach((button) => {
    button.addEventListener('click', () => {
      const amount = Number(button.getAttribute('data-donation-amount'));
      if (!Number.isFinite(amount) || amount <= 0) {
        return;
      }
      resetCustomDonationValidity();
      openPayPalDonation(amount);
      closeDonationDialog();
    });
  });

  const customDonationButton = document.querySelector('[data-custom-donation-submit]');
  customDonationButton?.addEventListener('click', () => {
    const amount = getCustomDonationAmount();
    if (amount === null) {
      return;
    }
    openPayPalDonation(amount);
    closeDonationDialog();
  });

  const skipDonationButton = document.querySelector('[data-skip-donation]');
  skipDonationButton?.addEventListener('click', () => {
    revealDownloads('Download links are ready below.');
    closeDonationDialog();
  });
</script>
