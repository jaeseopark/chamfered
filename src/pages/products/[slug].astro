---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const products = await getCollection('products');

  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const pageDescription = product.body?.trim() || `${product.data.title} by Chamfered`;
const physicalPurchaseLinks = [
  product.data.purchase.physical?.ebay
    ? { href: product.data.purchase.physical.ebay, label: 'Buy on eBay', icon: 'pricetag-outline', accent: 'bg-[#e53238]' }
    : null,
  product.data.purchase.physical?.amazon
    ? { href: product.data.purchase.physical.amazon, label: 'Buy on Amazon', icon: 'logo-amazon', accent: 'bg-[#ff9900]' }
    : null,
  product.data.purchase.physical?.etsy
    ? { href: product.data.purchase.physical.etsy, label: 'Buy on Etsy', icon: 'bag-handle-outline', accent: 'bg-[#f1641e]' }
    : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
const digitalPurchaseLinks = [
  product.data.purchase.digital?.makerworld
    ? { href: product.data.purchase.digital.makerworld, label: 'Download from MakerWorld', icon: 'cube-outline', accent: 'bg-[#0f766e]' }
    : null,
  product.data.purchase.digital?.printables
    ? { href: product.data.purchase.digital.printables, label: 'Download from Printables', icon: 'print-outline', accent: 'bg-[#fa6831]' }
    : null,
  product.data.purchase.digital?.thingiverse
    ? { href: product.data.purchase.digital.thingiverse, label: 'Download from Thingiverse', icon: 'layers-outline', accent: 'bg-[#248bfb]' }
    : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
const productMode = physicalPurchaseLinks.length > 0 && digitalPurchaseLinks.length > 0
  ? 'Physical + digital'
  : digitalPurchaseLinks.length > 0
    ? 'Digital file'
    : 'Physical product';
---

<Layout title={`${product.data.title} | Chamfered`} description={pageDescription}>
  <Header />

  <main class="min-h-[70vh] bg-white pb-20 pt-20">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/#shop"
        class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-[hsl(176,35%,45%)] transition-colors hover:text-[hsl(176,35%,35%)]"
      >
        <ion-icon name="arrow-back-outline" aria-hidden="true" />
        Back to products
      </a>

      <article class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,0.9fr)] lg:gap-12">
        <div class="space-y-6">
          <div class="overflow-hidden rounded-[1.5rem] border border-[hsl(0,0%,90%)] bg-[hsl(0,0%,97%)]">
            <img
              src={product.data.image}
              alt={product.data.title}
              class="aspect-[4/5] w-full object-cover"
            />
          </div>

          <div class="rounded-[1.5rem] border border-[hsl(0,0%,90%)] bg-[hsl(0,0%,99%)] p-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="inline-flex rounded-full bg-[hsl(176,35%,63%)]/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.28em] text-[hsl(176,56%,28%)]">
                {productMode}
              </span>
              {product.data.badge && (
                <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold text-white ${product.data.badgeColor === 'red' ? 'bg-[hsl(356,65%,63%)]' : 'bg-[hsl(148,45%,58%)]'}`}>
                  {product.data.badge}
                </span>
              )}
            </div>

            <div class="prose prose-sm mt-5 max-w-none text-[hsl(0,0%,30%)]">
              <Content />
            </div>
          </div>
        </div>

        <div class="lg:sticky lg:top-24">
          <div class="rounded-[1.5rem] border border-[hsl(0,0%,90%)] bg-white p-6 shadow-sm">
            <h1 class="text-3xl font-bold leading-tight text-[hsl(0,0%,9%)] sm:text-4xl">
              {product.data.title}
            </h1>

            <div class="mt-4 flex items-center gap-3">
              <p class="text-2xl font-bold text-[hsl(0,0%,9%)]">
                ${product.data.price.toFixed(2)}
              </p>
              {product.data.originalPrice && (
                <p class="text-base text-[hsl(0,0%,44%)] line-through">
                  ${product.data.originalPrice.toFixed(2)}
                </p>
              )}
            </div>

            <div class="mt-6 rounded-2xl border border-[hsl(0,0%,92%)] bg-[hsl(0,0%,99%)] p-4 text-sm text-[hsl(0,0%,35%)]">
              <div class="flex items-center justify-between gap-3 border-b border-[hsl(0,0%,92%)] pb-3">
                <span class="font-medium text-[hsl(0,0%,25%)]">Format</span>
                <span>{productMode}</span>
              </div>
              <div class="mt-3 flex items-center justify-between gap-3 border-b border-[hsl(0,0%,92%)] pb-3">
                <span class="font-medium text-[hsl(0,0%,25%)]">Physical marketplaces</span>
                <span>{physicalPurchaseLinks.length || 0}</span>
              </div>
              <div class="mt-3 flex items-center justify-between gap-3">
                <span class="font-medium text-[hsl(0,0%,25%)]">Digital download links</span>
                <span>{digitalPurchaseLinks.length || 0}</span>
              </div>
            </div>

            {physicalPurchaseLinks.length > 0 && (
              <div class="mt-8">
                <h2 class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(0,0%,38%)]">
                  Buy a finished part
                </h2>
                <div class="mt-4 flex flex-wrap gap-3">
                  {physicalPurchaseLinks.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer noopener"
                      class={`inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:brightness-95 ${link.accent}`}
                    >
                      <ion-icon name={link.icon} aria-hidden="true" />
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {digitalPurchaseLinks.length > 0 && (
              <div class="mt-8">
                <h2 class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(0,0%,38%)]">
                  Download the design
                </h2>
                <p class="mt-3 text-sm text-[hsl(0,0%,44%)]">
                  Use the support prompt before revealing the available download platforms.
                </p>
                <button
                  type="button"
                  class="mt-4 inline-flex items-center gap-2 rounded-full bg-[hsl(176,35%,63%)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[hsl(176,35%,50%)]"
                  data-digital-download-trigger
                  aria-haspopup="dialog"
                >
                  <ion-icon name="download-outline" aria-hidden="true" />
                  Download design file
                </button>
              </div>
            )}
          </div>
        </div>
      </article>
    </section>
  </main>

  <Footer />

  {digitalPurchaseLinks.length > 0 && (
    <dialog
      class="w-full max-w-md rounded-2xl border border-[hsl(0,0%,85%)] p-0 shadow-2xl [&::backdrop]:bg-black/40"
      data-donation-dialog
    >
      <div class="p-6 sm:p-7">
        <div class="mb-4 flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[hsl(176,56%,28%)]">Digital support</p>
            <h2 class="mt-2 text-2xl font-bold text-[hsl(0,0%,9%)]">Support this design</h2>
          </div>
          <button
            type="button"
            class="rounded-full border border-[hsl(0,0%,85%)] px-3 py-1 text-sm font-medium text-[hsl(0,0%,35%)]"
            data-close-donation-dialog
          >
            Close
          </button>
        </div>

        <div data-donation-stage>
          <p class="mb-5 text-sm text-[hsl(0,0%,35%)]">
            Would you like to support Chamfered with a donation before downloading?
          </p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href="https://www.paypal.com/donate/?hosted_button_id=FFUCZRH3R62CE"
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-200"
              style="background-color: rgb(255, 209, 64); color: rgb(0, 48, 135);"
              data-proceed-to-downloads
            >
              <ion-icon name="logo-paypal" aria-hidden="true" />
              Donate
            </a>
            <button
              type="button"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-full bg-[hsl(176,35%,63%)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[hsl(176,35%,50%)]"
              data-skip-donation
            >
              <ion-icon name="arrow-forward-outline" aria-hidden="true" />
              Skip
            </button>
          </div>
        </div>

        <div data-downloads-stage class="hidden">
          <p class="mb-5 text-sm text-[hsl(0,0%,35%)]">
            Download links are available below.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            {digitalPurchaseLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer noopener"
                class={`inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:brightness-95 ${link.accent}`}
              >
                <ion-icon name={link.icon} aria-hidden="true" />
                {link.label}
              </a>
            ))}
          </div>

          <button
            type="button"
            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[hsl(0,0%,90%)] px-5 py-3 text-sm font-semibold text-[hsl(0,0%,25%)] transition-colors hover:bg-[hsl(0,0%,80%)]"
            data-back-to-donation
          >
            <ion-icon name="arrow-back-outline" aria-hidden="true" />
            Back
          </button>
        </div>
      </div>
    </dialog>
  )}
</Layout>

<script>
  const downloadTrigger = document.querySelector('[data-digital-download-trigger]');
  const donationDialog = document.querySelector('[data-donation-dialog]');
  const donationStage = document.querySelector('[data-donation-stage]');
  const downloadsStage = document.querySelector('[data-downloads-stage]');
  const proceedToDownloadsLinks = document.querySelectorAll('[data-proceed-to-downloads]');
  const skipDonationButtons = document.querySelectorAll('[data-skip-donation]');
  const backToDonationButtons = document.querySelectorAll('[data-back-to-donation]');

  const closeDonationDialog = () => {
    if (!(donationDialog instanceof HTMLDialogElement)) {
      return;
    }
    if (donationDialog.open) {
      donationDialog.close();
    }
    if (donationStage instanceof HTMLElement && downloadsStage instanceof HTMLElement) {
      donationStage.classList.remove('hidden');
      downloadsStage.classList.add('hidden');
    }
  };

  const proceedToDownloads = () => {
    if (donationStage instanceof HTMLElement && downloadsStage instanceof HTMLElement) {
      donationStage.classList.add('hidden');
      downloadsStage.classList.remove('hidden');
    }
  };

  const backToDonation = () => {
    if (donationStage instanceof HTMLElement && downloadsStage instanceof HTMLElement) {
      donationStage.classList.remove('hidden');
      downloadsStage.classList.add('hidden');
    }
  };

  if (downloadTrigger instanceof HTMLButtonElement) {
    downloadTrigger.addEventListener('click', () => {
      if (donationDialog instanceof HTMLDialogElement) {
        donationDialog.showModal();
      }
    });
  }

  document.querySelectorAll('[data-close-donation-dialog]').forEach((button) => {
    button.addEventListener('click', closeDonationDialog);
  });

  proceedToDownloadsLinks.forEach((link) => {
    link.addEventListener('click', () => {
      proceedToDownloads();
    });
  });

  skipDonationButtons.forEach((button) => {
    button.addEventListener('click', proceedToDownloads);
  });

  backToDonationButtons.forEach((button) => {
    button.addEventListener('click', backToDonation);
  });

  if (donationDialog instanceof HTMLDialogElement) {
    donationDialog.addEventListener('click', (event) => {
      if (event.target === donationDialog) {
        closeDonationDialog();
      }
    });
  }
</script>
