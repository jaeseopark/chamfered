---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const products = await getCollection('products');

  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const primaryLink = product.data.ebayLink ?? product.data.makerWorldLink;
const primaryLinkLabel = product.data.ebayLink ? 'Buy on eBay' : product.data.makerWorldLink ? 'Get on MakerWorld' : null;
const [thumbnailImage, ...lightboxImages] = product.data.images;
if (!thumbnailImage) {
  throw new Error(`Product "${product.id}" is missing a required thumbnail image.`);
}
const lightboxIdPrefix = `lightbox-${product.id.replace(/[^a-z0-9-]/gi, '-')}`;
const metaDescription = (product.body ?? '')
  .replace(/[#*_`>\[\]()-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);
---

<Layout title={`${product.data.title} | Chamfered`} description={metaDescription || product.data.title}>
  <Header />

  <main class="pt-20 pb-20 bg-white min-h-[70vh]">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/#shop"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[hsl(176,35%,45%)] hover:text-[hsl(176,35%,35%)] transition-colors mb-8"
      >
        <ion-icon name="arrow-back-outline" aria-hidden="true" />
        Back to products
      </a>

      <article class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div class="bg-[hsl(0,0%,97%)] rounded-xl border border-[hsl(0,0%,90%)] overflow-hidden">
          <img
            src={thumbnailImage}
            alt={product.data.title}
            class="w-full h-full object-cover aspect-[4/5]"
          />
        </div>

        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-[hsl(0,0%,9%)] leading-tight mb-3">
            {product.data.title}
          </h1>

          <div class="flex items-center gap-3 mb-6">
            <p class="text-2xl font-bold text-[hsl(0,0%,9%)]">
              ${product.data.price.toFixed(2)}
            </p>
            {product.data.originalPrice && (
              <p class="text-base text-[hsl(0,0%,44%)] line-through">
                ${product.data.originalPrice.toFixed(2)}
              </p>
            )}
            {product.data.badge && (
              <span class={`inline-flex items-center text-xs px-2 py-1 rounded text-white ${product.data.badgeColor === 'red' ? 'bg-[hsl(356,65%,63%)]' : 'bg-[hsl(148,45%,58%)]'}`}>
                {product.data.badge}
              </span>
            )}
          </div>

          <div class="prose prose-sm max-w-none text-[hsl(0,0%,30%)] mb-8">
            <Content />
          </div>

          {lightboxImages.length > 0 && (
            <div class="mb-8">
              <h2 class="text-sm font-semibold text-[hsl(0,0%,25%)] mb-3">More images</h2>
              <div class="flex flex-wrap gap-3">
                {lightboxImages.map((image, index) => (
                  <a
                    href={`#${lightboxIdPrefix}-${index}`}
                    class="w-20 h-20 rounded-lg overflow-hidden border border-[hsl(0,0%,86%)] hover:border-[hsl(0,0%,70%)] transition-colors"
                    aria-label={`View image ${index + 2} of ${product.data.title}`}
                  >
                    <img
                      src={image}
                      alt={`Additional product photo of ${product.data.title}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="flex flex-wrap items-center gap-3">
            {primaryLink && primaryLinkLabel && (
              <a
                href={primaryLink}
                target="_blank"
                rel="noreferrer noopener"
                class="inline-flex items-center gap-2 bg-[hsl(176,35%,63%)] hover:bg-[hsl(176,35%,50%)] text-white text-sm font-semibold px-5 py-3 rounded-full transition-colors"
              >
                <ion-icon name="open-outline" aria-hidden="true" />
                {primaryLinkLabel}
              </a>
            )}

            <a
              href="/#shop"
              class="inline-flex items-center gap-2 text-sm font-semibold border border-[hsl(0,0%,86%)] text-[hsl(0,0%,25%)] hover:border-[hsl(0,0%,70%)] px-5 py-3 rounded-full transition-colors"
            >
              Browse more products
            </a>
          </div>
        </div>
      </article>
    </section>
  </main>

  {lightboxImages.map((image, index) => (
    <div
      id={`${lightboxIdPrefix}-${index}`}
      class="fixed inset-0 z-50 bg-black/85 p-4 sm:p-8 opacity-0 pointer-events-none transition-opacity [&:target]:opacity-100 [&:target]:pointer-events-auto"
    >
      <a href="#" class="absolute inset-0" aria-label="Close image"></a>
      <div class="relative max-w-4xl mx-auto h-full flex items-center justify-center">
        <img
          src={image}
          alt={`Enlarged product photo of ${product.data.title}`}
          class="max-w-full max-h-full rounded-xl shadow-2xl object-contain"
          loading="lazy"
        />
        <a
          href="#"
          class="absolute top-2 right-2 inline-flex items-center justify-center w-9 h-9 rounded-full bg-white/90 text-[hsl(0,0%,20%)] hover:bg-white transition-colors"
          aria-label="Close image"
        >
          <ion-icon name="close-outline" aria-hidden="true" />
        </a>
      </div>
    </div>
  ))}

  <Footer />
</Layout>
