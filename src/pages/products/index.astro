---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const products = (await getCollection('products'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title="Full Product Catalog | Chamfered" description="Browse the complete Chamfered product catalog.">
  <Header />

  <main class="min-h-[70vh] bg-white pb-20 pt-20">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 rounded-[1.75rem] border border-[hsl(0,0%,90%)] bg-[hsl(0,0%,99%)] px-6 py-8 shadow-sm sm:px-8">
        <span class="inline-flex rounded-full bg-[hsl(176,35%,63%)]/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.28em] text-[hsl(176,56%,28%)]">
          Catalog
        </span>
        <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <h1 class="text-3xl font-bold sm:text-4xl">
              Full product catalog with clear marketplace and download actions.
            </h1>
            <p class="mt-4 max-w-2xl text-[hsl(0,0%,44%)]">
              Browse the complete list of Chamfered products, including featured items and the full archive.
            </p>
          </div>
          <div class="grid gap-3 text-sm text-[hsl(0,0%,44%)] sm:grid-cols-2">
            <div class="rounded-2xl border border-[hsl(0,0%,90%)] bg-white p-4">
              <p class="font-semibold text-[hsl(0,0%,9%)]">Physical listings</p>
              <p class="mt-1">eBay, Amazon, and Etsy buttons where available.</p>
            </div>
            <div class="rounded-2xl border border-[hsl(0,0%,90%)] bg-white p-4">
              <p class="font-semibold text-[hsl(0,0%,9%)]">Digital downloads</p>
              <p class="mt-1">MakerWorld, Printables, and Thingiverse support.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
        {products.map((product) => (
          <ProductCard
            title={product.data.title}
            price={product.data.price}
            originalPrice={product.data.originalPrice}
            badge={product.data.badge}
            badgeColor={product.data.badgeColor}
            image={product.data.image}
            productHref={`/products/${product.id}/`}
            hasPhysicalPurchase={product.data.purchase.physical !== undefined}
            hasDigitalPurchase={product.data.purchase.digital !== undefined}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
