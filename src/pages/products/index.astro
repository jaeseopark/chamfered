---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const products = (await getCollection('products'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title="Full Product Catalog | Chamfered" description="Browse the complete Chamfered product catalog.">
  <Header />

  <main class="min-h-[70vh] pb-20 pt-28">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 overflow-hidden rounded-[2rem] border border-[hsl(180,15%,88%)] bg-[linear-gradient(135deg,rgba(15,23,42,0.98),rgba(15,118,110,0.92))] px-8 py-10 text-white shadow-[0_24px_70px_rgba(15,23,42,0.14)] sm:px-10">
        <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.32em] text-white/75">
          Catalog
        </span>
        <div class="mt-6 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <h1 class="text-3xl font-bold sm:text-4xl">
              Full product catalog with modern marketplace and download actions.
            </h1>
            <p class="mt-4 max-w-2xl text-white/75">
              Browse the complete list of Chamfered products, including featured items and the full archive.
            </p>
          </div>
          <div class="grid gap-3 text-sm text-white/75 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/12 bg-white/10 p-4">
              <p class="font-semibold text-white">Physical listings</p>
              <p class="mt-1">eBay, Amazon, and Etsy buttons where available.</p>
            </div>
            <div class="rounded-2xl border border-white/12 bg-white/10 p-4">
              <p class="font-semibold text-white">Digital downloads</p>
              <p class="mt-1">MakerWorld, Printables, and Thingiverse support.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
        {products.map((product) => (
          <ProductCard
            title={product.data.title}
            price={product.data.price}
            originalPrice={product.data.originalPrice}
            badge={product.data.badge}
            badgeColor={product.data.badgeColor}
            image={product.data.image}
            productHref={`/products/${product.id}/`}
            hasPhysicalPurchase={product.data.purchase.physical !== undefined}
            hasDigitalPurchase={product.data.purchase.digital !== undefined}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
